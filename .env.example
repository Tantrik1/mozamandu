# Mozamandu Web Application Environment Variables
# Copy this file to .env for local development

# Supabase Credentials (Public / Anon Client)
VITE_SUPABASE_URL="
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key-here"
VITE_SUPABASE_PROJECT_ID=""

# Express R2 Backend Server Port
PORT=3001

# Cloudflare R2 Bucket S3 API Credentials (Server-side Only - Keep Secret)
R2_ACCESS_KEY_ID="your-cloudflare-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-cloudflare-r2-secret-access-key"
R2_ENDPOINT=""
R2_BUCKET=""
R2_PUBLIC_DOMAIN="""

# Supabase Service Role Key (Server-side Administrative Access - Keep Secret)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"
